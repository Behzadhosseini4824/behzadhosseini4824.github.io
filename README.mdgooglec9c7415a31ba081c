<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Tahoma, Arial, sans-serif;
    background:#f4f7fb;
    color:#1e293b;
    line-height:1.9;
}

header{
    position:fixed;
    top:0;
    width:100%;
    z-index:1000;
    background:rgba(15,23,42,.94);
    backdrop-filter:blur(10px);
    box-shadow:0 4px 20px rgba(0,0,0,.15);
}

nav{
    max-width:1200px;
    margin:auto;
    padding:12px 20px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    color:white;
    font-size:21px;
    font-weight:bold;
}

.logo span{
    color:#38bdf8;
}

nav ul{
    display:flex;
    list-style:none;
    gap:8px;
}

nav ul li a{
    color:white;
    text-decoration:none;
    padding:9px 13px;
    border-radius:10px;
    transition:.3s;
    font-size:14px;
}

nav ul li a:hover{
    background:#0284c7;
}

.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:120px 20px 70px;
    background:
    linear-gradient(135deg,rgba(15,23,42,.94),rgba(3,105,161,.88)),
    radial-gradient(circle at top right,#38bdf8,transparent 40%);
    color:white;
}

.hero-content{
    max-width:900px;
}

.profile{
    width:170px;
    height:170px;
    border-radius:50%;
    object-fit:cover;
    border:5px solid rgba(255,255,255,.9);
    box-shadow:0 15px 40px rgba(0,0,0,.3);
    margin-bottom:20px;
}

.hero h1{
    font-size:42px;
    margin-bottom:10px;
}

.hero h1 span{
    color:#7dd3fc;
}

.hero h2{
    font-size:21px;
    font-weight:normal;
    margin-bottom:20px;
}

.hero p{
    max-width:720px;
    margin:auto;
    opacity:.92;
}

.buttons{
    margin-top:30px;
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
}

.btn{
    display:inline-block;
    text-decoration:none;
    padding:12px 25px;
    border-radius:30px;
    background:#38bdf8;
    color:#082f49;
    font-weight:bold;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(0,0,0,.2);
}

.btn.secondary{
    background:transparent;
    color:white;
    border:1px solid rgba(255,255,255,.7);
}

section{
    max-width:1150px;
    margin:auto;
    padding:90px 20px;
}

.section-title{
    text-align:center;
    margin-bottom:45px;
}

.section-title h2{
    font-size:31px;
    color:#0f172a;
}

.section-title p{
    color:#64748b;
}

.about{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:30px;
}

.card{
    background:white;
    padding:28px;
    border-radius:22px;
    box-shadow:0 10px 30px rgba(15,23,42,.08);
    transition:.3s;
}

.card:hover{
    transform:translateY(-6px);
    box-shadow:0 18px 35px rgba(15,23,42,.13);
}

.info-list{
    list-style:none;
}

.info-list li{
    padding:11px 0;
    border-bottom:1px solid #e2e8f0;
}

.info-list li:last-child{
    border-bottom:0;
}

.info-list strong{
    color:#0369a1;
}

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    margin-top:30px;
}

.stat{
    background:linear-gradient(135deg,#0369a1,#0284c7);
    color:white;
    padding:25px 15px;
    text-align:center;
    border-radius:20px;
}

.stat h3{
    font-size:30px;
}

.stat p{
    font-size:14px;
}

.timeline{
    position:relative;
    max-width:850px;
    margin:auto;
}

.timeline-item{
    background:white;
    margin:20px 0;
    padding:24px;
    border-radius:18px;
    box-shadow:0 8px 25px rgba(15,23,42,.07);
    border-right:5px solid #0284c7;
}

.timeline-item h3{
    color:#0369a1;
}

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.work-card{
    background:white;
    padding:25px;
    border-radius:22px;
    box-shadow:0 10px 28px rgba(15,23,42,.08);
    transition:.3s;
}

.work-card:hover{
    transform:translateY(-8px);
}

.icon{
    width:55px;
    height:55px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:15px;
    background:#e0f2fe;
    color:#0369a1;
    font-size:25px;
    margin-bottom:15px;
}

.gallery{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:15px;
}

.gallery img{
    width:100%;
    height:230px;
    object-fit:cover;
    border-radius:18px;
    cursor:pointer;
    transition:.3s;
}

.gallery img:hover{
    transform:scale(1.03);
}

.contact-box{
    text-align:center;
    background:linear-gradient(135deg,#0f172a,#075985);
    color:white;
    padding:45px 25px;
    border-radius:28px;
}

.contact-box h2{
    margin-bottom:15px;
}

.social{
    margin-top:25px;
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
}

.social a{
    color:white;
    text-decoration:none;
    border:1px solid rgba(255,255,255,.4);
    padding:9px 18px;
    border-radius:25px;
}

footer{
    background:#020617;
    color:#cbd5e1;
    text-align:center;
    padding:25px 15px;
    font-size:13px;
}

.top{
    position:fixed;
    bottom:20px;
    left:20px;
    width:45px;
    height:45px;
    background:#0284c7;
    color:white;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    text-decoration:none;
    box-shadow:0 8px 20px rgba(0,0,0,.2);
}

@media(max-width:850px){
    nav{
        flex-direction:column;
        gap:8px;
    }

    nav ul{
        flex-wrap:wrap;
        justify-content:center;
    }

    .hero h1{
        font-size:31px;
    }

    .about,
    .cards{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .gallery{
        grid-template-columns:1fr 1fr;
    }
}

@media(max-width:500px){
    nav ul li a{
        font-size:12px;
        padding:7px 8px;
    }

    .profile{
        width:135px;
        height:135px;
    }

    .gallery{
        grid-template-columns:1fr;
    }

    .hero h1{
        font-size:27px;
    }
}
</style>
