<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>بهزاد حسینی | فرهنگی و فعال اجتماعی شهر شاهو</title>

<meta name="description"
content="وب‌سایت رسمی و شخصی بهزاد حسینی، فرهنگی، مدیر آموزشی و فعال اجتماعی شهر شاهو">

<meta name="author" content="بهزاد حسینی">

<meta name="theme-color" content="#08111f">

<style>

/* =====================================================
   RESET
===================================================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:
    Tahoma,
    Arial,
    sans-serif;

    background:#f4f7fb;
    color:#172235;
    line-height:2;
    overflow-x:hidden;
}

a{
    text-decoration:none;
    color:inherit;
}

img{
    max-width:100%;
}

.container{
    width:92%;
    max-width:1180px;
    margin:auto;
}


/* =====================================================
   SCROLL BAR
===================================================== */

::-webkit-scrollbar{
    width:9px;
}

::-webkit-scrollbar-track{
    background:#07101d;
}

::-webkit-scrollbar-thumb{
    background:#c9a45e;
    border-radius:20px;
}


/* =====================================================
   HEADER
===================================================== */

header{
    position:fixed;
    top:0;
    right:0;
    left:0;

    height:76px;

    z-index:9999;

    background:rgba(5,13,26,.90);

    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);

    border-bottom:
    1px solid rgba(255,255,255,.09);

    transition:.3s;
}

header.scrolled{
    background:rgba(4,10,20,.98);

    box-shadow:
    0 10px 35px rgba(0,0,0,.25);
}

.nav{
    height:76px;

    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    color:#fff;

    font-size:21px;
    font-weight:bold;

    white-space:nowrap;
}

.logo span{
    color:#d8b36a;
}

.menu{
    display:flex;
    align-items:center;
    gap:24px;

    color:#d8e1ee;

    font-size:14px;
}

.menu a{
    position:relative;
    transition:.3s;
}

.menu a:after{
    content:"";

    position:absolute;

    right:0;
    bottom:-8px;

    width:0;
    height:2px;

    background:#d8b36a;

    transition:.3s;
}

.menu a:hover{
    color:#e0bc76;
}

.menu a:hover:after{
    width:100%;
}


/* =====================================================
   MOBILE MENU BUTTON
===================================================== */

.menu-btn{
    display:none;

    width:45px;
    height:45px;

    border:1px solid rgba(255,255,255,.15);
    border-radius:12px;

    background:rgba(255,255,255,.06);

    color:#fff;

    font-size:23px;

    cursor:pointer;
}


/* =====================================================
   HERO
===================================================== */

.hero{
    min-height:100vh;

    padding-top:76px;

    position:relative;

    display:flex;
    align-items:center;

    color:#fff;

    overflow:hidden;

    background:
    radial-gradient(
        circle at 80% 20%,
        #29476d 0%,
        #13233a 34%,
        #08111f 72%,
        #040a13 100%
    );
}

.hero:before{
    content:"";

    position:absolute;

    width:600px;
    height:600px;

    left:-260px;
    bottom:-330px;

    border:
    1px solid rgba(216,179,106,.18);

    border-radius:50%;

    box-shadow:
    0 0 0 80px rgba(216,179,106,.025),
    0 0 0 160px rgba(216,179,106,.018);
}

.hero:after{
    content:"";

    position:absolute;

    width:280px;
    height:280px;

    right:-100px;
    top:110px;

    background:
    radial-gradient(
        circle,
        rgba(216,179,106,.13),
        transparent 70%
    );

    border-radius:50%;
}

.hero-grid{
    position:relative;
    z-index:2;

    display:grid;

    grid-template-columns:
    1.15fr .85fr;

    gap:70px;

    align-items:center;

    padding:90px 0;
}

.hero-content{
    animation:
    fadeUp .9s ease both;
}

.badge{
    display:inline-flex;
    align-items:center;

    gap:8px;

    padding:6px 17px;

    border:
    1px solid rgba(216,179,106,.55);

    border-radius:50px;

    color:#e2c27e;

    font-size:13px;

    background:
    rgba(216,179,106,.05);

    margin-bottom:22px;
}

.badge:before{
    content:"●";

    font-size:8px;
}

.hero h1{
    font-size:
    clamp(45px,7vw,82px);

    line-height:1.15;

    margin-bottom:10px;

    letter-spacing:-2px;
}

.hero h1 span{
    color:#d8b36a;
}

.hero h2{
    color:#dce6f3;

    font-size:21px;

    line-height:1.8;

    font-weight:500;

    margin-bottom:20px;
}

.hero p{
    color:#b8c5d6;

    max-width:690px;

    font-size:16px;
}

.buttons{
    margin-top:30px;

    display:flex;
    flex-wrap:wrap;

    gap:12px;
}

.btn{
    display:inline-flex;

    align-items:center;
    justify-content:center;

    min-height:48px;

    padding:10px 23px;

    border-radius:13px;

    background:#d8b36a;

    color:#101825;

    font-weight:bold;

    transition:.3s;

    border:1px solid #d8b36a;
}

.btn:hover{
    transform:translateY(-3px);

    box-shadow:
    0 12px 30px rgba(216,179,106,.25);
}

.btn-outline{
    background:transparent;

    color:#fff;

    border-color:#53657f;
}

.btn-outline:hover{
    background:#fff;
    color:#101825;
}


/* =====================================================
   PROFILE
===================================================== */

.profile-wrap{
    display:flex;
    justify-content:center;

    animation:
    fadeUp 1.1s .15s ease both;
}

.profile{
    width:min(100%,410px);

    min-height:500px;

    padding:16px;

    border-radius:34px;

    position:relative;

    background:
    linear-gradient(
        145deg,
        rgba(255,255,255,.14),
        rgba(255,255,255,.025)
    );

    border:
    1px solid rgba(255,255,255,.18);

    box-shadow:
    0 35px 90px rgba(0,0,0,.45);

    overflow:hidden;
}

.profile:before{
    content:"";

    position:absolute;

    inset:9px;

    border:
    1px solid rgba(216,179,106,.28);

    border-radius:27px;

    pointer-events:none;

    z-index:2;
}

.profile img{
    width:100%;

    height:465px;

    object-fit:cover;

    display:block;

    border-radius:25px;

    border:
    3px solid rgba(216,179,106,.65);
}

.profile-fallback{
    width:100%;
    height:465px;

    border-radius:25px;

    display:none;

    align-items:center;
    justify-content:center;

    text-align:center;

    color:#dce5f1;

    background:
    linear-gradient(
        145deg,
        #1c3452,
        #091322
    );

    padding:30px;
}


/* =====================================================
   SECTION
===================================================== */

section{
    padding:100px 0;
}

.section-title{
    text-align:center;

    margin-bottom:55px;
}

.eyebrow{
    color:#aa7830;

    font-size:13px;

    font-weight:bold;

    letter-spacing:.3px;
}

.section-title h2{
    font-size:36px;

    line-height:1.4;

    margin:
    5px 0 10px;
}

.section-title p{
    max-width:750px;

    margin:auto;

    color:#68758a;

    font-size:15px;
}


/* =====================================================
   ABOUT
===================================================== */

.about{
    background:#fff;
}

.about-grid{
    display:grid;

    grid-template-columns:
    .72fr 1.28fr;

    gap:50px;

    align-items:start;
}

.info-box{
    background:
    linear-gradient(
        145deg,
        #101e33,
        #091322
    );

    color:#fff;

    padding:30px;

    border-radius:26px;

    box-shadow:
    0 20px 50px rgba(10,22,40,.14);
}

.info{
    padding:15px 0;

    border-bottom:
    1px solid rgba(255,255,255,.09);
}

.info:last-child{
    border-bottom:0;
}

.info strong{
    display:block;

    color:#dfbb76;

    margin-bottom:2px;
}

.info span{
    color:#c5d0df;

    font-size:14px;
}

.text p{
    color:#536075;

    margin-bottom:18px;

    font-size:15px;
}

.highlight{
    padding:20px 23px;

    margin-top:25px;

    border-right:
    4px solid #d8b36a;

    background:#f7f4ed;

    border-radius:12px;

    color:#4d5869;

    font-weight:500;
}


/* =====================================================
   STATS
===================================================== */

.stats{
    background:#f4f7fb;
}

.stats-grid{
    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:18px;
}

.stat{
    text-align:center;

    padding:30px 18px;

    background:#fff;

    border-radius:22px;

    border:
    1px solid #e4e9f0;

    transition:.3s;
}

.stat:hover{
    transform:translateY(-5px);

    box-shadow:
    0 18px 40px rgba(25,35,55,.08);
}

.stat-number{
    font-size:35px;

    font-weight:bold;

    color:#b2833e;
}

.stat-title{
    color:#5d697b;

    font-size:14px;
}


/* =====================================================
   CAREER
===================================================== */

.timeline{
    max-width:900px;

    margin:auto;

    position:relative;

    display:grid;

    gap:18px;
}

.timeline:before{
    content:"";

    position:absolute;

    top:10px;
    bottom:10px;

    right:19px;

    width:2px;

    background:#e0e5ec;
}

.timeline-item{
    position:relative;

    padding:
    25px
    55px
    25px
    25px;

    background:#fff;

    border-radius:21px;

    border:
    1px solid #e2e7ee;

    box-shadow:
    0 8px 30px rgba(20,32,55,.045);

    transition:.3s;
}

.timeline-item:before{
    content:"";

    position:absolute;

    right:10px;
    top:31px;

    width:18px;
    height:18px;

    border-radius:50%;

    background:#d8b36a;

    border:
    4px solid #fff;

    box-shadow:
    0 0 0 2px #d8b36a;
}

.timeline-item:hover{
    transform:translateX(-5px);

    box-shadow:
    0 16px 35px rgba(20,32,55,.08);
}

.timeline-item h3{
    font-size:19px;

    margin-bottom:5px;

    color:#1b2739;
}

.timeline-item p{
    color:#667388;

    font-size:14px;
}


/* =====================================================
   PROJECTS
===================================================== */

.projects{
    background:#edf2f7;
}

.project-grid{
    display:grid;

    grid-template-columns:
    repeat(3,1fr);

    gap:20px;
}

.project{
    position:relative;

    overflow:hidden;

    background:#fff;

    border-radius:23px;

    padding:28px;

    border:
    1px solid #e0e6ee;

    transition:.35s;
}

.project:before{
    content:"";

    position:absolute;

    width:90px;
    height:90px;

    left:-40px;
    bottom:-40px;

    border-radius:50%;

    background:
    rgba(216,179,106,.08);
}

.project:hover{
    transform:translateY(-7px);

    box-shadow:
    0 20px 45px rgba(20,30,50,.10);
}

.icon{
    width:58px;
    height:58px;

    display:flex;
    align-items:center;
    justify-content:center;

    border-radius:17px;

    background:#f5efe3;

    font-size:29px;

    margin-bottom:16px;
}

.project h3{
    font-size:18px;

    margin-bottom:7px;
}

.project p{
    color:#667388;

    font-size:14px;
}


/* =====================================================
   QUOTE
===================================================== */

.quote{
    position:relative;

    background:
    linear-gradient(
        135deg,
        #0b1729,
        #142a45
    );

    color:#fff;

    text-align:center;

    overflow:hidden;
}

.quote:before{
    content:"“";

    position:absolute;

    font-family:Georgia,serif;

    font-size:240px;

    line-height:1;

    color:rgba(216,179,106,.08);

    top:-20px;

    right:7%;
}

.quote blockquote{
    position:relative;
    z-index:2;

    max-width:880px;

    margin:auto;

    font-size:27px;

    line-height:2;

    font-weight:bold;
}

.quote small{
    display:block;

    color:#bdc9d9;

    margin-top:20px;

    font-size:14px;
}


/* =====================================================
   YOUTH
===================================================== */

.youth{
    background:#fff;
}

.two-column{
    display:grid;

    grid-template-columns:
    1fr 1fr;

    gap:25px;
}

.list-box{
    background:#f5f7fa;

    padding:30px;

    border-radius:24px;

    border:1px solid #e5eaf0;
}

.list-box li{
    list-style:none;

    padding:12px 0;

    border-bottom:
    1px solid #e1e6ed;

    color:#435066;
}

.list-box li:last-child{
    border-bottom:0;
}

.list-box li:before{
    content:"✓";

    color:#b2833e;

    font-weight:bold;

    margin-left:9px;
}


/* =====================================================
   GALLERY
===================================================== */

.gallery{
    background:#edf2f7;
}

.gallery-grid{
    display:grid;

    grid-template-columns:
    repeat(4,1fr);

    gap:15px;
}

.gallery-item{
    height:210px;

    border-radius:20px;

    overflow:hidden;

    position:relative;

    display:flex;

    align-items:flex-end;

    justify-content:center;

    text-align:center;

    padding:18px;

    color:#fff;

    font-weight:bold;

    background:
    linear-gradient(
        145deg,
        #162943,
        #667892
    );

    transition:.35s;
}

.gallery-item:hover{
    transform:scale(1.025);

    box-shadow:
    0 18px 35px rgba(20,30,50,.15);
}

.gallery-item span{
    position:relative;
    z-index:2;
}

.gallery-item:after{
    content:"";

    position:absolute;

    inset:0;

    background:
    linear-gradient(
        transparent 20%,
        rgba(0,0,0,.75)
    );
}


/* =====================================================
   CONTACT
===================================================== */

.contact{
    background:#fff;
}

.contact-box{
    max-width:900px;

    margin:auto;

    padding:45px 30px;

    border-radius:28px;

    text-align:center;

    color:#fff;

    background:
    linear-gradient(
        135deg,
        #0d1b30,
        #172d49
    );

    box-shadow:
    0 25px 60px rgba(8,20,38,.18);
}

.contact-box h3{
    font-size:27px;

    margin-bottom:8px;
}

.contact-box p{
    color:#c2cddd;

    max-width:650px;

    margin:
    8px auto 25px;
}

.contact-links{
    display:flex;

    justify-content:center;

    flex-wrap:wrap;

    gap:12px;

    margin-bottom:25px;
}

.contact-link{
    padding:10px 18px;

    border-radius:12px;

    border:1px solid rgba(255,255,255,.14);

    background:rgba(255,255,255,.05);

    color:#dbe4ef;

    font-size:14px;
}


/* =====================================================
   FOOTER
===================================================== */

footer{
    background:#050b14;

    color:#aeb9c9;

    text-align:center;

    padding:38px 15px;

    font-size:13px;
}

footer strong{
    color:#dfbb76;
}

.footer-line{
    width:70px;
    height:2px;

    background:#c9a45e;

    margin:14px auto;
}


/* =====================================================
   BACK TO TOP
===================================================== */

.top-btn{
    position:fixed;

    bottom:20px;
    left:20px;

    width:45px;
    height:45px;

    border:0;

    border-radius:13px;

    background:#d8b36a;

    color:#111b29;

    font-size:20px;

    cursor:pointer;

    opacity:0;
    visibility:hidden;

    transition:.3s;

    z-index:999;
}

.top-btn.show{
    opacity:1;
    visibility:visible;
}


/* =====================================================
   ANIMATION
===================================================== */

.reveal{
    opacity:0;

    transform:translateY(30px);

    transition:
    opacity .7s ease,
    transform .7s ease;
}

.reveal.active{
    opacity:1;

    transform:translateY(0);
}

@keyframes fadeUp{

    from{
        opacity:0;
        transform:translateY(30px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}


/* =====================================================
   MOBILE
===================================================== */

@media(max-width:900px){

    .menu{
        display:none;

        position:absolute;

        top:76px;
        right:4%;
        left:4%;

        padding:15px;

        flex-direction:column;

        gap:0;

        background:#08111f;

        border:
        1px solid rgba(255,255,255,.1);

        border-radius:18px;

        box-shadow:
        0 20px 50px rgba(0,0,0,.35);
    }

    .menu.active{
        display:flex;
    }

    .menu a{
        width:100%;

        padding:12px 10px;

        border-bottom:
        1px solid rgba(255,255,255,.06);
    }

    .menu a:last-child{
        border-bottom:0;
    }

    .menu-btn{
        display:block;
    }

    .hero-grid{
        grid-template-columns:1fr;

        text-align:center;
    }

    .hero p{
        margin:auto;
    }

    .buttons{
        justify-content:center;
    }

    .profile-wrap{
        order:-1;
    }

    .profile{
        max-width:360px;

        min-height:auto;
    }

    .profile img,
    .profile-fallback{
        height:390px;
    }

    .about-grid{
        grid-template-columns:1fr;
    }

    .stats-grid{
        grid-template-columns:1fr 1fr;
    }

    .project-grid{
        grid-template-columns:1fr 1fr;
    }

    .gallery-grid{
        grid-template-columns:1fr 1fr;
    }

}


@media(max-width:560px){

    .container{
        width:90%;
    }

    section{
        padding:70px 0;
    }

    .hero-grid{
        padding:65px 0;
    }

    .hero h1{
        font-size:48px;

        letter-spacing:-1px;
    }

    .hero h2{
        font-size:18px;
    }

    .hero p{
        font-size:14px;
    }

    .profile{
        max-width:310px;
    }

    .profile img,
    .profile-fallback{
        height:350px;
    }

    .section-title{
        margin-bottom:35px;
    }

    .section-title h2{
        font-size:29px;
    }

    .stats-grid,
    .project-grid,
    .gallery-grid,
    .two-column{
        grid-template-columns:1fr;
    }

    .gallery-item{
        height:190px;
    }

    .quote blockquote{
        font-size:21px;
    }

    .contact-box{
        padding:35px 20px;
    }

    .contact-box h3{
        font-size:23px;
    }

}


/* =====================================================
   ACCESSIBILITY
===================================================== */

@media(prefers-reduced-motion:reduce){

    html{
        scroll-behavior:auto;
    }

    *,
    *:before,
    *:after{
        animation:none !important;
        transition:none !important;
    }

}

</style>
</head>


