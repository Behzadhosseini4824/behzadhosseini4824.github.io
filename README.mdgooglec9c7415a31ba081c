<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

:root{
    --navy:#071b32;
    --blue:#0d3558;
    --blue2:#164d78;
    --gold:#d7a23a;
    --gold2:#f0c96d;
    --white:#ffffff;
    --light:#f5f7fa;
    --text:#172436;
    --muted:#68778a;
    --border:#e4e9ef;
}

body{
    font-family:
    Tahoma,
    Arial,
    sans-serif;
    background:var(--light);
    color:var(--text);
    line-height:1.9;
}

a{
    text-decoration:none;
    color:inherit;
}

.container{
    width:92%;
    max-width:1180px;
    margin:auto;
}

/* ================= NAVBAR ================= */

.navbar{
    position:fixed;
    top:0;
    right:0;
    left:0;
    height:74px;
    z-index:9999;
    background:rgba(7,27,50,.94);
    backdrop-filter:blur(12px);
    box-shadow:0 5px 25px rgba(0,0,0,.18);
}

.nav-inner{
    height:74px;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-size:22px;
    font-weight:bold;
    color:#fff;
}

.logo span{
    color:var(--gold);
}

.menu{
    display:flex;
    align-items:center;
    gap:25px;
    list-style:none;
}

.menu a{
    color:#fff;
    font-size:14px;
    transition:.3s;
}

.menu a:hover{
    color:var(--gold2);
}

.menu-btn{
    display:none;
    font-size:29px;
    color:#fff;
    cursor:pointer;
}

/* ================= HERO ================= */

.hero{
    min-height:100vh;
    padding-top:74px;
    display:flex;
    align-items:center;
    position:relative;
    overflow:hidden;
    color:#fff;

    background:
    radial-gradient(circle at 15% 20%,
    rgba(215,162,58,.18),
    transparent 30%),

    radial-gradient(circle at 90% 80%,
    rgba(37,111,165,.25),
    transparent 35%),

    linear-gradient(135deg,
    #06172b,
    #0c3152 55%,
    #071b32);
}

.hero:before{
    content:"";
    position:absolute;
    width:450px;
    height:450px;
    border:1px solid rgba(255,255,255,.08);
    border-radius:50%;
    top:-180px;
    left:-130px;
}

.hero:after{
    content:"";
    position:absolute;
    width:600px;
    height:600px;
    border:1px solid rgba(215,162,58,.08);
    border-radius:50%;
    bottom:-350px;
    right:-180px;
}

.hero-grid{
    position:relative;
    z-index:2;

    display:grid;
    grid-template-columns:1.1fr .9fr;
    align-items:center;
    gap:70px;
}

.hero-text h4{
    color:var(--gold2);
    font-size:16px;
    margin-bottom:12px;
}

.hero-text h1{
    font-size:56px;
    line-height:1.35;
    margin-bottom:8px;
}

.hero-text h1 span{
    color:var(--gold);
}

.hero-text h2{
    font-size:24px;
    font-weight:normal;
    color:#e3ebf4;
    margin-bottom:25px;
}

.hero-text p{
    max-width:690px;
    color:#c8d5e2;
    font-size:17px;
}

.hero-buttons{
    margin-top:32px;
    display:flex;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:12px 25px;
    border-radius:50px;
    font-weight:bold;
    transition:.3s;
}

.btn-gold{
    background:var(--gold);
    color:#12263d;
}

.btn-gold:hover{
    transform:translateY(-3px);
    box-shadow:0 12px 30px rgba(215,162,58,.3);
}

.btn-outline{
    border:1px solid rgba(255,255,255,.7);
    color:#fff;
}

.btn-outline:hover{
    background:#fff;
    color:var(--navy);
}

/* PROFILE */

.hero-photo{
    display:flex;
    justify-content:center;
}

.photo-frame{
    width:370px;
    height:450px;
    padding:12px;
    border-radius:35px;
    background:
    linear-gradient(145deg,
    #fff,
    var(--gold),
    #fff);
    box-shadow:
    0 30px 70px rgba(0,0,0,.4);
    transform:rotate(2deg);
}

.photo-box{
    width:100%;
    height:100%;
    border-radius:27px;
    background:
    linear-gradient(145deg,
    #183c5b,
    #082039);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    overflow:hidden;
}

.initials{
    width:185px;
    height:185px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;

    background:
    linear-gradient(145deg,
    var(--gold),
    var(--gold2));

    color:#17314c;
    font-size:65px;
    font-weight:bold;

    border:8px solid rgba(255,255,255,.8);

    margin-bottom:25px;
}

.photo-box h3{
    font-size:25px;
}

.photo-box p{
    color:#cbd8e5;
}

/* ================= SECTION ================= */

section{
    padding:95px 0;
}

.section-head{
    text-align:center;
    margin-bottom:50px;
}

.section-head h2{
    font-size:35px;
    color:var(--blue);
}

.section-head p{
    color:var(--muted);
    margin-top:5px;
}

.gold-line{
    width:75px;
    height:4px;
    background:var(--gold);
    border-radius:10px;
    margin:15px auto;
}

/* ================= ABOUT ================= */

.about{
    background:#fff;
}

.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:30px;
}

.about-card{
    background:#f8fafc;
    border:1px solid var(--border);
    border-radius:24px;
    padding:32px;
}

.about-card h3{
    color:var(--blue);
    margin-bottom:18px;
    font-size:22px;
}

.about-card p{
    color:#596a7c;
}

.info-list{
    list-style:none;
}

.info-list li{
    padding:11px 0;
    border-bottom:1px solid #e1e7ed;
}

.info-list li:last-child{
    border-bottom:none;
}

.info-list strong{
    color:var(--blue);
}

/* ================= STATS ================= */

.stats{
    background:
    linear-gradient(135deg,
    #071b32,
    #10466e);
    color:#fff;
}

.stats-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.stat{
    text-align:center;
    padding:30px 15px;
    border-radius:22px;
    background:rgba(255,255,255,.05);
    border:1px solid rgba(255,255,255,.12);
}

.stat-number{
    font-size:40px;
    font-weight:bold;
    color:var(--gold2);
}

.stat-title{
    color:#d8e3ed;
}

/* ================= ACHIEVEMENTS ================= */

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:25px;
}

.card{
    background:#fff;
    padding:30px;
    border-radius:23px;
    border:1px solid var(--border);
    box-shadow:0 8px 30px rgba(12,39,66,.06);
    transition:.3s;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 18px 45px rgba(12,39,66,.13);
}

.card-icon{
    width:58px;
    height:58px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:17px;
    background:#eef4f8;
    font-size:28px;
    margin-bottom:18px;
}

.card h3{
    color:var(--blue);
    margin-bottom:10px;
}

.card p{
    color:var(--muted);
    font-size:14px;
}

/* ================= PROGRAMS ================= */

.programs{
    background:#fff;
}

.program-box{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:20px;
}

.program{
    padding:25px;
    border-radius:20px;
    background:#f7f9fb;
    border:1px solid var(--border);
}

.program h3{
    color:var(--blue);
    margin-bottom:8px;
}

.program p{
    color:var(--muted);
}

/* ================= TIMELINE ================= */

.timeline{
    max-width:900px;
    margin:auto;
    position:relative;
}

.timeline:before{
    content:"";
    position:absolute;
    top:0;
    bottom:0;
    right:22px;
    width:3px;
    background:var(--gold);
}

.timeline-item{
    position:relative;
    padding-right:70px;
    margin-bottom:30px;
}

.timeline-item:before{
    content:"";
    position:absolute;
    right:11px;
    top:10px;
    width:20px;
    height:20px;
    background:var(--gold);
    border-radius:50%;
    border:5px solid #fff;
    box-shadow:0 0 0 2px var(--gold);
}

.timeline-card{
    background:#fff;
    border:1px solid var(--border);
    padding:25px;
    border-radius:20px;
    box-shadow:0 8px 25px rgba(0,0,0,.05);
}

.timeline-card small{
    color:var(--gold);
    font-weight:bold;
}

.timeline-card h3{
    color:var(--blue);
}

/* ================= MESSAGE ================= */

.message{
    color:#fff;
    background:
    radial-gradient(circle at 80% 20%,
    rgba(215,162,58,.18),
    transparent 25%),
    linear-gradient(135deg,
    #071b32,
    #123f62);
}

.message-content{
    max-width:850px;
    text-align:center;
    margin:auto;
}

.message-content h2{
    font-size:35px;
    margin-bottom:20px;
}

.message-content p{
    color:#d5e0ea;
    font-size:17px;
}

/* ================= GALLERY ================= */

.gallery{
    background:#fff;
}

.gallery-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.gallery-item{
    height:230px;
    border-radius:20px;
    overflow:hidden;
    background:
    linear-gradient(135deg,
    #d7a23a,
    #0d3558);
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    font-size:20px;
    font-weight:bold;
    position:relative;
}

.gallery-item span{
    background:rgba(0,0,0,.35);
    padding:8px 18px;
    border-radius:30px;
}

/* ================= CONTACT ================= */

.contact{
    background:var(--light);
}

.contact-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:22px;
}

.contact-card{
    background:#fff;
    border:1px solid var(--border);
    padding:30px;
    border-radius:22px;
    text-align:center;
}

.contact-icon{
    font-size:30px;
    margin-bottom:10px;
}

.contact-card h3{
    color:var(--blue);
}

.contact-card p{
    color:var(--muted);
}

/* ================= FOOTER ================= */

footer{
    background:#06172b;
    color:#d8e3ed;
    text-align:center;
    padding:35px 15px;
}

footer strong{
    color:var(--gold2);
}

/* ================= TOP BUTTON ================= */

.top-btn{
    position:fixed;
    bottom:20px;
    left:20px;
    width:48px;
    height:48px;
    background:var(--gold);
    color:#12263d;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
    z-index:999;
    box-shadow:0 8px 25px rgba(0,0,0,.2);
}

/* ================= MOBILE ================= */

@media(max-width:900px){

    .menu-btn{
        display:block;
    }

    .menu{
        display:none;
        position:absolute;
        top:74px;
        right:0;
        left:0;
        background:#071b32;
        flex-direction:column;
        align-items:stretch;
        padding:15px 20px;
    }

    .menu.active{
        display:flex;
    }

    .menu li{
        padding:12px;
        border-bottom:1px solid rgba(255,255,255,.1);
    }

    .hero-grid{
        grid-template-columns:1fr;
        text-align:center;
        gap:45px;
    }

    .hero-text h1{
        font-size:40px;
    }

    .hero-text h2{
        font-size:20px;
    }

    .hero-text p{
        margin:auto;
    }

    .hero-buttons{
        justify-content:center;
    }

    .hero-photo{
        order:-1;
    }

    .photo-frame{
        width:280px;
        height:340px;
    }

    .initials{
        width:140px;
        height:140px;
        font-size:50px;
    }

    .about-grid{
        grid-template-columns:1fr;
    }

    .stats-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .cards{
        grid-template-columns:1fr;
    }

    .program-box{
        grid-template-columns:1fr;
    }

    .gallery-grid{
        grid-template-columns:1fr 1fr;
    }

    .contact-grid{
        grid-template-columns:1fr;
    }
}

@media(max-width:550px){

    .hero-text h1{
        font-size:34px;
    }

    .hero-text h2{
        font-size:18px;
    }

    .hero-text p{
        font-size:15px;
    }

    .stats-grid{
        grid-template-columns:1fr 1fr;
        gap:12px;
    }

    .stat-number{
        font-size:32px;
    }

    .gallery-grid{
        grid-template-columns:1fr;
    }

    .gallery-item{
        height:200px;
    }

    section{
        padding:70px 0;
    }

    .section-head h2{
        font-size:29px;
    }
}
</style>
</head>

